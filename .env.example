# مثال إعدادات — انسخه لـ .env وعدّل القيم
# (متسجّلش التوكن الحقيقي في git)

# على السيرفر (GPU):
TTS_ENGINE=local
TTS_SERVER_TOKEN=change-me-to-a-long-random-secret
HF_HOME=/models
TTS_OUTPUT_DIR=/outputs

# على جهازك المحلي (عشان يبعت للسيرفر):
# TTS_ENGINE=server
# TTS_SERVER_URL=https://xxxxx-8000.proxy.runpod.net
# TTS_SERVER_TOKEN=نفس-التوكن-اللي-على-السيرفر
